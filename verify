#!/usr/bin/env python3
"""verify —— 离线会签核验台的一次性可执行验收服务。

执行后退出，以退出码报告三大类验收结果：
  1. 业务验收：API/HTTP 冒烟（有效会签接受、篡改份额拒绝并定位失败份额、
     冻结/重放/冲突语义、页面与静态资源、证据接口）；
  2. 构建检查：有 Docker 时真实构建镜像并以临时宿主端口启动做健康探测；
     无 Docker 守护时执行严格静态校验 + 按镜像 COPY 清单在隔离目录做
     等价启动冒烟（标记 EMULATED）；
  3. 代码测试：RFC 9591 密码规则 unittest 全套。

任一必检项 FAIL -> 退出码 1；全部 PASS/SKIP -> 0。
用法：./verify
"""

from __future__ import annotations

import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request

ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)

PASS, FAIL, SKIP = "PASS", "FAIL", "SKIP"
results: list[tuple[str, str, str]] = []  # (类别, 状态, 说明)


def record(section: str, status: str, detail: str) -> None:
    results.append((section, status, detail))
    mark = {"PASS": "✅ PASS", "FAIL": "❌ FAIL", "SKIP": "⏭️  SKIP"}[status]
    print(f"[{mark}] {section}: {detail}")


def run_cmd(argv: list[str], *, cwd: str = ROOT, env: dict | None = None,
            timeout: int = 600) -> subprocess.CompletedProcess:
    return subprocess.run(
        argv,
        cwd=cwd,
        env=env,
        capture_output=True,
        text=True,
        timeout=timeout,
    )


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


# ---------------------------------------------------------------------------
# 1) 密码规则代码测试
# ---------------------------------------------------------------------------
def code_tests() -> None:
    print("\n=== 1/3 密码规则代码测试（unittest） ===")
    proc = run_cmd(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-v"],
        timeout=300,
    )
    # unittest 的统计在 stderr（被合并到 stdout 由捕获决定），取末尾摘要。
    tail = (proc.stdout + proc.stderr).strip().splitlines()[-3:]
    if proc.returncode == 0:
        record("代码测试", PASS, " ".join(tail) or "全部通过")
    else:
        record("代码测试", FAIL, f"退出码 {proc.returncode}；" + " / ".join(tail))


# ---------------------------------------------------------------------------
# 2) 业务验收（API/HTTP 冒烟，含页面）
# ---------------------------------------------------------------------------
def business_smoke() -> None:
    print("\n=== 2/3 业务验收：API/HTTP 冒烟（含有效/篡改会签与页面） ===")
    proc = run_cmd([sys.executable, os.path.join("tests", "acceptance_smoke.py")], timeout=180)
    out = proc.stdout + proc.stderr
    if proc.returncode == 0 and "SMOKE PASS" in out:
        lines = [ln.strip("- ").strip() for ln in out.splitlines() if ln.strip().startswith("-")]
        record("API/HTTP 冒烟", PASS, f"{len(lines)} 项检查全部通过（含篡改份额定位）")
        for ln in lines:
            print(f"         · {ln}")
    else:
        record("API/HTTP 冒烟", FAIL, "冒烟失败：\n" + out[-1500:])


# ---------------------------------------------------------------------------
# 3) 镜像构建检查
# ---------------------------------------------------------------------------
def _docker_available() -> str | None:
    exe = shutil.which("docker")
    if not exe:
        return None
    probe = subprocess.run([exe, "info", "--format", "{{.ServerVersion}}"],
                           capture_output=True, text=True, timeout=20)
    if probe.returncode != 0:
        return None
    return probe.stdout.strip() or "available"


def _wait_health(url: str, seconds: float = 15.0) -> bool:
    deadline = time.time() + seconds
    while time.time() < deadline:
        try:
            with urllib.request.urlopen(url, timeout=2) as resp:
                if resp.status == 200 and json.loads(resp.read()).get("status") == "ok":
                    return True
        except Exception:
            time.sleep(0.4)
    return False


def _static_image_checks() -> list[str]:
    """对 Dockerfile 与 compose 清单做严格静态校验，返回错误列表。"""
    errors: list[str] = []
    dockerfile = open(os.path.join(ROOT, "Dockerfile"), encoding="utf-8").read()
    for needle in ("FROM python:", "WORKDIR", "COPY app", "CMD", "EXPOSE", "HEALTHCHECK", "USER"):
        if needle not in dockerfile:
            errors.append(f"Dockerfile 缺少 {needle}")
    # COPY 源必须存在；不得把数据目录/测试残留烧入镜像。
    for src in ("app", "README.md"):
        if not os.path.exists(os.path.join(ROOT, src)):
            errors.append(f"COPY 源不存在：{src}")
    for banned in ("data/", "__pycache__", ".git/"):
        copy_lines = [
            ln for ln in dockerfile.splitlines()
            if ln.strip().startswith(("COPY", "ADD"))
        ]
        if any(banned in ln for ln in copy_lines):
            errors.append(f"镜像 COPY/ADD 疑似包含不应烧入内容：{banned}")

    compose = open(os.path.join(ROOT, "docker-compose.yml"), encoding="utf-8").read()
    for needle in ("build:", "ports:", "${DESK_HOST_PORT", "healthcheck:", "/healthz"):
        if needle not in compose:
            errors.append(f"compose 清单缺少 {needle}")
    return errors


def _emulated_image_run() -> tuple[bool, str]:
    """按 Dockerfile 的 COPY 清单在隔离目录组装并以镜像相同命令启动探测。"""
    tmp = tempfile.mkdtemp(prefix="frost-image-emulation-")
    dst_app = os.path.join(tmp, "app")
    shutil.copytree(os.path.join(ROOT, "app"), dst_app,
                    ignore=shutil.ignore_patterns("__pycache__"))
    shutil.copy(os.path.join(ROOT, "README.md"), os.path.join(tmp, "README.md"))
    port = free_port()
    env = {**os.environ, "HOST": "127.0.0.1", "PORT": str(port),
           "EVIDENCE_DB": os.path.join(tmp, "data", "evidence.json")}
    proc = subprocess.Popen(
        [sys.executable, "-m", "app.server"], cwd=tmp, env=env,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
    )
    try:
        ok = _wait_health(f"http://127.0.0.1:{port}/healthz")
        if ok:
            page = urllib.request.urlopen(f"http://127.0.0.1:{port}/", timeout=3).read()
            ok = "会签核验台".encode() in page
        return ok, f"隔离目录镜像内容启动 + 健康/页面探测（端口 {port}）"
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except subprocess.TimeoutExpired:
            proc.kill()
        shutil.rmtree(tmp, ignore_errors=True)


def image_check() -> None:
    print("\n=== 3/3 构建检查：镜像（Docker 真实构建 / 无守护时隔离仿真） ===")
    errors = _static_image_checks()
    if errors:
        record("镜像静态校验", FAIL, "；".join(errors))
        return
    record("镜像静态校验", PASS, "Dockerfile / docker-compose.yml 清单完整，宿主端口可配置")

    docker = _docker_available()
    if docker:
        tag = "frost-countersign-desk:verify"
        built = run_cmd(["docker", "build", "-t", tag, "."], timeout=600)
        if built.returncode != 0:
            record("镜像构建", FAIL, (built.stderr or built.stdout)[-800:])
            return
        record("镜像构建", PASS, f"docker build 成功（Docker {docker}）")
        port = free_port()
        name = f"frost-verify-{port}"
        run_cmd(["docker", "rm", "-f", name])  # 清理同名残留
        run_cmd([
            "docker", "run", "-d", "--name", name,
            "-p", f"{port}:8080",
            "-e", "PORT=8080",
            tag,
        ])
        try:
            if _wait_health(f"http://127.0.0.1:{port}/healthz"):
                record("容器健康探测", PASS, f"容器在宿主端口 {port} 返回 /healthz ok")
            else:
                record("容器健康探测", FAIL, f"端口 {port} 健康检查未就绪")
        finally:
            run_cmd(["docker", "logs", name])
            run_cmd(["docker", "rm", "-f", name])
    else:
        record("镜像构建", SKIP, "本机无可用 Docker 守护，改执行隔离仿真启动")
        ok, detail = _emulated_image_run()
        if ok:
            record("镜像内容仿真启动", PASS, "EMULATED：" + detail)
        else:
            record("镜像内容仿真启动", FAIL, "EMULATED 启动/健康/页面探测失败")


def main() -> int:
    print("############################################################")
    print("# FROST 会签核验台 verify —— 一次性验收（RFC 9591 Ed25519） #")
    print("############################################################")
    code_tests()
    business_smoke()
    image_check()

    print("\n================= 验收汇总 =================")
    for section, status, _detail in results:
        mark = {"PASS": "✅", "FAIL": "❌", "SKIP": "⏭️"}[status]
        print(f"  {mark} {section:<22} {status}")
    failed = [s for _, s, _ in results if s == FAIL]
    skipped = [s for _, s, _ in results if s == SKIP]
    print("-------------------------------------------")
    if failed:
        print(f"结果：FAIL（{len(failed)} 项失败），退出码 1")
        return 1
    tail = "（含 SKIP 回退项，已在上方明确标注）" if skipped else ""
    print(f"结果：PASS，退出码 0 {tail}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
